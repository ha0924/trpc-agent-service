# 密钥环境变量示例。
#
# 复制为 .env 后填入真实值，`.env` 已被 .gitignore 排除。
#
#   cp .env.example .env
#   $EDITOR .env
#   set -a && . ./.env && set +a && WORKERS=1 ./start.sh
#
# 一期的 Secret Manager 实现是环境变量映射（见 configs/config.yaml 的
# secrets.mapping）。库里只存 secret:// 引用，明文只在这里。
#
# 为什么值得有这个文件：导出动作本身也需要一个落脚处。手敲 export 时漏一个
# 字符——比如把 sk-xxx 写成 $sk-xxx——shell 会把它当未定义变量展开成空串，
# 于是密钥静默变成错的，而报错要等到第一次调模型时才出现。

# ---------------------------------------------------------------------------
# tenant-demo
# ---------------------------------------------------------------------------
MOCK_CHANNEL_TOKEN=mock-token-abc
DEEPSEEK_API_KEY=sk-填入你的密钥

# 企业微信自建应用（URL 回调模式）的凭据块。
# 含 corp_id / secret / agent_id / token / encoding_aes_key 五项。
WECOM_CREDENTIALS={"corp_id":"","secret":"","agent_id":0,"token":"","encoding_aes_key":""}

# ---------------------------------------------------------------------------
# tenant-acme：第二个租户，密钥各自独立
#
# 独立不是形式：一个租户的密钥解析失败只影响该租户，不波及其他租户。
# ---------------------------------------------------------------------------
ACME_CHANNEL_TOKEN=acme-token-xyz
ACME_API_KEY=sk-填入你的密钥

# ---------------------------------------------------------------------------
# tenant-test：企业微信智能机器人长连接联调
# ---------------------------------------------------------------------------
TEST_API_KEY=sk-填入你的密钥

# 长连接的凭据块只含 bot_id / secret——明文传输，无需验签与解密，
# 因此没有 token 与 encoding_aes_key。与上面 WECOM_CREDENTIALS 结构不同。
WECOM_AIBOT_CREDENTIALS={"bot_id":"aib...","secret":"..."}
